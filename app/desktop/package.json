{
  "name": "schema-editor-desktop",
  "private": true,
  "description": "Schema Editor desktop shell (Electron) that loads the frontend build and bridges the local file system",
  "homepage": "https://github.com/zhang-brook/schema-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang-brook/schema-editor"
  },
  "author": "zhang-brook",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "start": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron .",
    "build:main": "vite build && vite build --mode preload",
    "type-check": "tsc --noEmit",
    "pack": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --config electron-builder.mjs --publish never"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "cross-env": "^10.0.0",
    "electron": "~44.7.2",
    "electron-builder": "^26.15.3",
    "schema-editor-bridge": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
