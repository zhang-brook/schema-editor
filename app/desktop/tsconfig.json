{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/**/*", "vite.config.mts"],
  "compilerOptions": {
    // Matches the root project: Bundler resolution and no type output in the build output
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  }
}
