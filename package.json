{
  "name": "schema-editor",
  "private": true,
  "version": "0.7.0",
  "author": "zhang-brook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang-brook/schema-editor"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm -C app/web dev",
    "build": "pnpm -C app/web build",
    "preview": "pnpm -C app/web preview",
    "test:unit": "vitest",
    "type-check": "run-s type-check:root type-check:core type-check:web type-check:desktop",
    "type-check:root": "tsc -p tsconfig.node.json",
    "type-check:core": "tsc -p packages/core",
    "type-check:web": "pnpm -C app/web type-check",
    "type-check:desktop": "pnpm -C app/desktop type-check",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt app/web/src/",
    "changelog": "node scripts/changelog.mjs",
    "desktop:dev": "run-p dev desktop:start",
    "desktop:start": "pnpm -C app/desktop start",
    "desktop:build": "run-s desktop:build:renderer desktop:build:main",
    "desktop:build:renderer": "pnpm -C app/web exec vite build --outDir ../desktop/renderer --emptyOutDir",
    "desktop:build:main": "pnpm -C app/desktop build:main",
    "desktop:dist": "run-s desktop:build desktop:pack",
    "desktop:pack": "pnpm -C app/desktop run pack"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
